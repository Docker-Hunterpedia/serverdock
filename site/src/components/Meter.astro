---
// A fixed figure, not <meter>/<progress>. The visible text carries the meaning; the bar is
// decorative. The fill's width attribute is computed here from value / max.
interface Props { text: string; value: number; max: number; }
const { text, value, max } = Astro.props;
const pct = Math.round((value / max) * 1000) / 10;
---

<div class="meter">
	<p class="meter-text">{text}</p>
	<svg viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true" focusable="false">
		<rect class="track" x="0" y="0" width="100" height="6" rx="3"></rect>
		<rect class="fill" x="0" y="0" width={pct} height="6" rx="3"></rect>
	</svg>
</div>
