{
  "name": "serverdock-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ServerDock's single-page app. Node is needed to build it only; the server embeds the output.",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5173",
    "build": "vite build && node scripts/compress.mjs && node scripts/size-check.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "types": "openapi-typescript ../docs/api/openapi.json -o src/lib/api/types.ts",
    "size": "node scripts/size-check.mjs"
  },
  "dependencies": {
    "@sveltejs/kit": "3.4.0",
    "svelte": "5.59.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "openapi-typescript": "7.13.0",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
